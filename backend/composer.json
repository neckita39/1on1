{
    "name": "app/1on1",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^3.0",
        "firebase/php-jwt": "^6.10",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-client": "*",
        "symfony/property-access": "^7.0",
        "symfony/runtime": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "symfony/maker-bundle": "^1.52"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "extra": {
        "symfony": {
            "allow-contrib": false
        }
    }
}
